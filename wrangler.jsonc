{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runlu-csu-investment-ai-v1",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "CSU_SYMBOL": "CSU",
    "CSU_EXCHANGE": "TSX"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
